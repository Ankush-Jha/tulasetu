{
  "buildCommand": "npm run build --workspace=apps/web",
  "installCommand": "npm install && node scripts/build-api.mjs",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/handler"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

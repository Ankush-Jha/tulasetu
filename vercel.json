{
  "buildCommand": "npm run build --workspace=apps/web",
  "installCommand": "npm install && node scripts/build-api.mjs",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "tulasetu-sih.vercel.app" }],
      "destination": "https://taraazu.vercel.app/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "tulasetu-app.vercel.app" }],
      "destination": "https://taraazu.vercel.app/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "tulasetu-metrology.vercel.app" }],
      "destination": "https://taraazu.vercel.app/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "tulasetu-nawi.vercel.app" }],
      "destination": "https://taraazu.vercel.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/handler"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

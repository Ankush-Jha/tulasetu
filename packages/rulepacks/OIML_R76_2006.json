      "n_max": 10000,
      "min_capacity": "20e"
    },
    {
      "class": "IIII",
      "e_min_g": 5,
      "e_max_g": null,
      "n_min": 100,
      "n_max": 1000,
      "min_capacity": "10e"
    }
  ],
  "classification_clause": "R 76-1:2006 Table 3 (= India Seventh Schedule Table 17)",
  "classification_exceptions": [
    {
      "class": "I",
      "condition": "d < 0.1 mg",
      "effect": "n may be less than 50 000",
      "clause": "R 76-1:2006 §3.4.4"
    }
  ],
  "mpe_bands_initial": [
    {
      "limit": "0.5e",
      "max_m_in_e": {
        "I": 50000,
        "II": 5000,
        "III": 500,
        "IIII": 50
      }
    },
    {
      "limit": "1.0e",
      "max_m_in_e": {
        "I": 200000,
        "II": 20000,
        "III": 2000,
        "IIII": 200
      }
    },
    {
      "limit": "1.5e",
      "max_m_in_e": {
        "I": null,
        "II": 100000,
        "III": 10000,
        "IIII": 1000
      }
    }
  ],
  "mpe_in_service_factor": 2,
  "mpe_in_service_clause": "R 76-1:2006 §3.5.2 — in-service mpe is twice the initial-verification mpe",
  "multi_interval_boundary": {
    "I": 50000,
    "II": 5000,
    "III": 500,
    "IIII": 50
  },
  "multi_interval_boundary_clause": "R 76-1:2006 Table 4 — Max_i / e_(i+1) shall be at least this value",
  "rounding_elimination_when": "d > 0.2e",
  "rounding_elimination_clause": "R 76-1:2006 §3.5.3.2",
  "module_error_fractions": {
    "rule": "sum(p_i^2) <= 1",
    "p_max": 0.8,
    "p_min": 0.3,
    "digital_module_may_be_zero": true,
    "weighing_module_may_be_one": true,
    "clause": "R 76-1:2006 §3.10.2.1 and Table 7",
    "note": "p_min applies only where more than one module contributes to the error.",
    "typical": {
      "load_cell": 0.7,
      "indicator": 0.5,
      "connecting": 0.5
    }
  },
  "family_solver": {
    "eut_must_include": [
      "highest_n",
      "smallest_e"
    ],
    "eut_clause": "R 76-1:2006 §3.10.4.2",
    "accept_without_test_if": [
      "Max falls between two tested capacities whose ratio does not exceed max_capacity_ratio",
      "n <= n_test AND e >= e_test AND Max <= max_multiplier * Max_test * (n_test / n)"
    ],
    "accept_clause": "R 76-1:2006 §3.10.4.3",
    "max_capacity_ratio": 10,
    "max_multiplier": 5
  },
  "kernel_params": {
    "discrimination": {
      "extra_load_factor_digital": 1.4,
      "analog_displacement_fraction": 0.7,
      "non_self_extra_load_fraction": 0.4,
      "clause": "R 76-1:2006 §3.8.1, §3.8.2.1, Annex A.4.8.2"
    },
    "sensitivity": {
      "min_displacement_mm": {
        "class_I_II": 1,
        "class_III_IIII_le_30kg": 2,
        "class_III_IIII_gt_30kg": 5
      },
      "max_boundary_kg": 30,
      "clause": "R 76-1:2006 §6.1"
    },
    "creep": {
      "terminate_at_30min_if_below_e": 0.5,
      "and_between_15_and_30min_below_e": 0.2,
      "otherwise_4h_limit": "|mpe|",
      "max_temperature_variation_C": 2,
      "clause": "R 76-1:2006 §4.6 / Annex A.4.10"
    },
    "zero_return": {
      "factor_single": 0.5,
      "factor_multi_interval": 0.5,
      "factor_multiple_range": 0.5,
      "secondary_factor_multiple_range": 1.0,
      "clause": "R 76-1:2006 §3.9.4.2",
      "note": "On a multi-interval instrument the limit is 0.5 x e1 — the smallest e, not the e at the applied load (§3.3.3 final paragraph). A multiple-range instrument carries an additional check of a full e1 over 5 minutes after switching down from a load above Max1."
    },
    "temperature_no_load": {
      "drift_per_C": {
        "I": 1,
        "default": 5
      },
      "uses_e1_for_multi_range": true,
      "clause": "R 76-1:2006 §3.9.2.3"
    },
    "span_stability": {
      "variation_factor": 0.5,
      "variation_basis": "max(e, |mpe_initial|)",
      "clause": "R 76-1:2006 Annex B.4 / §5.3.3"
    },
    "stability_of_equilibrium": {
      "print_deviation_in_e": 1,
      "max_adjacent_values": 2,
      "zero_setting_limit_in_e": 0.25,
      "required_trials": 5,
      "clause": "R 76-1:2006 §A.4.12 / §4.4.2, and R 76-2:2007 form 7",
      "note": "Fixed multiples of e, printed on the form itself. The mpe band plays no part in this test."
    },
    "significant_fault": {
      "threshold": "e",
      "comparison": "strictly greater than",
      "clause": "R 76-1:2006 §T.5.5.6 and §5.1.1",
      "note": "A fault of exactly e is permitted; only a fault greater than e is significant. Four exclusions apply (simultaneous independent causes, impossibility to measure, obviously wrong, transitory)."
    }
  },
  "tests": [

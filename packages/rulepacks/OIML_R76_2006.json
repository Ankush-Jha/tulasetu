{
  "$schema": "./rulepack.schema.json",
  "ruleset_id": "OIML_R76_2006",
  "version": "1.2.0",
  "edition": "2007-report-format",
  "description": "OIML R 76-1:2006 requirements + R 76-2:2007 report format. Every value below is traced in docs/VERIFIED.md to a page of docs/standards/OIML_R76-1_2006_requirements.pdf or OIML_R76-2_2007_report_format.pdf.",
  "class_aliases": {
    "IIII": [
      "IV"
    ]
  },
  "accuracy_classes": [
    "I",
    "II",
    "III",
    "IIII"
  ],
  "e_form": [
    1,
    2,
    5
  ],
  "mpe_clause": "R 76-1:2006 §3.5.1 (Table 6), with §3.3 for multi-interval instruments",
  "classification": [
    {
      "class": "I",
      "e_min_g": 0.001,
      "e_max_g": null,
      "n_min": 50000,
      "n_max": null,
      "min_capacity": "100e"
    },
    {
      "class": "II",
      "e_min_g": 0.001,
      "e_max_g": 0.05,
      "n_min": 100,
      "n_max": 100000,

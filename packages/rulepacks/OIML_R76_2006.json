    },
    {
      "class": "II",
      "e_min_g": 0.1,
      "e_max_g": null,
      "n_min": 5000,
      "n_max": 100000,
      "min_capacity": "50e"
    },
    {
      "class": "III",
      "e_min_g": 0.1,
      "e_max_g": 2,
      "n_min": 100,
      "n_max": 10000,
      "min_capacity": "20e"
    },
    {
      "class": "III",
      "e_min_g": 5,
      "e_max_g": null,
